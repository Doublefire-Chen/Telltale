[Unit]
Description=Telltale Dashboard
Documentation=https://github.com/Doublefire-Chen/Telltale
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telltale
Group=telltale
ExecStart=/usr/local/bin/telltale-dashboard -config /etc/telltale/dashboard.toml
Restart=always
RestartSec=5

# All state lives in /var/lib/telltale (the SQLite database); systemd creates
# it owned by the telltale user, and it is the only writable path.
StateDirectory=telltale
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Go raises its open-file limit at start-up (setrlimit, in @resources), so
# that group stays allowed; anything filtered fails with EPERM, not SIGSYS.
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
